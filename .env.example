# انسخ الملف ده باسم .env وحط مفتاحك الحقيقي (ماترفعش .env على GitHub)
FIRMS_MAP_KEY=your_key_here
# اتجاه الرياح (اختياري) - مفتاح مجاني من https://openweathermap.org/api
# OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# تنبيهات الإيميل (اختياري) - شوف notify.py
# لجيميل: فعّل 2-Step Verification وبعدين اعمل App Password واستخدمه هنا (مش باسورد الحساب)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your_app_password
# ALERT_EMAIL_TO=you@gmail.com
# ALERT_EMAIL_FROM=FireLink <you@gmail.com>
